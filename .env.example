# OpenAI-compatible provider configuration.
# Copy this file to .env and replace placeholders with your provider settings.

API_KEY=your-provider-api-key
LLM_API_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openrouter/owl-alpha

# Must be vision-capable for frontend screenshot review.
FRONTEND_VISION_MODEL=qwen/qwen3-vl-8b-instruct

# LLM transport defaults.
# Streaming keeps long responses observable. Set LLM_READ_TIMEOUT_SECONDS to a
# positive value only when you intentionally want a body/read watchdog; 0 keeps
# long model reasoning unlimited.
LLM_STREAMING=true
LLM_STREAM_FALLBACK_TO_NON_STREAM=true
LLM_MAX_RETRIES=1
LLM_CONNECT_TIMEOUT_SECONDS=10
LLM_READ_TIMEOUT_SECONDS=0
LLM_WRITE_TIMEOUT_SECONDS=30
LLM_POOL_TIMEOUT_SECONDS=30

# Generated-code execution defaults.
# Use CODE_EXECUTOR=docker to run the agent on the host while executing each
# generated Python script in a short-lived Docker sandbox.
CODE_EXECUTOR=host
CODE_EXECUTOR_IMAGE=
CODE_EXECUTOR_DOCKER_NETWORK=none
CODE_EXECUTOR_TIMEOUT_SECONDS=600
CODE_EXECUTOR_OUTPUT_LIMIT_BYTES=4194304
CODE_EXECUTOR_MEMORY=4g
CODE_EXECUTOR_CPUS=4
CODE_EXECUTOR_PIDS_LIMIT=512
