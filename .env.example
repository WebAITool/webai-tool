# ─── LLM Provider ────────────────────────────────────────────────────
# Any OpenAI-compatible API: OpenRouter, polza.ai, local servers, etc.
LLM_MODEL=z-ai/glm-5
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=your-key-here

# Used by src/gener.py (SRS generation). Also used as fallback by
# lg_agent.py when LLM_API_KEY is not set.
API_KEY=your-key-here
